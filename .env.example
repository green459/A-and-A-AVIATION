# Copy this file to .env and fill in real values.

DATABASE_URL="mysql://user:password@localhost:3306/aaa-aviation"

# Seed admin account (used once by `bun prisma/seed.ts`).
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# Public site origin, used for canonical URLs, sitemap.xml, and robots.txt.
# Falls back to https://aaaviation.com if unset — set this in production.
NEXT_PUBLIC_SITE_URL="https://aaaviation.com"

# Cloudflare Turnstile (captcha) on the public inquiry form.
# These are Cloudflare's published "always pass" TEST keys — safe for local
# dev, but you MUST replace both with real keys from your own Turnstile
# site (dash.cloudflare.com > Turnstile) before deploying to production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# SMTP, used to send admin replies to inquiries directly from
# /controller/inquiries/[id] (see lib/email.ts). Optional — leave unset and
# the reply form still works, it just saves the reply and opens the admin's
# own mail app (mailto:) instead of sending it server-side. Any SMTP
# provider works (Gmail app password, Amazon SES, Mailgun, a company mail
# server, ...).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey-or-username"
# SMTP_PASSWORD="change-me"
# SMTP_FROM="A&A Aviation <info@aaaviation.com>"
